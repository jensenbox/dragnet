# Copy to .env next to docker-compose.yml and fill in real values.
# Never commit the real .env.

# Django — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=dragnet.jensenbox.com,192.168.16.10,localhost
TIME_ZONE=America/Vancouver

# --- Public hosting via Cloudflare tunnel -----------------------------------
# Required once the app is reachable at https://dragnet.jensenbox.com, or every
# POST (login, send, logout) fails CSRF validation.
CSRF_TRUSTED_ORIGINS=https://dragnet.jensenbox.com
# Session/CSRF cookies get the Secure flag. Turn this on once the tunnel is up.
# Trade-off: browser login over plain http://192.168.16.10:9180 stops working.
# The bearer-token API on :9180 is unaffected (it doesn't use cookies).
# Uncomment once the tunnel is serving traffic.
#SECURE_COOKIES=true
# HSTS. Start at 0, raise to 3600 to test, then 31536000 once you're confident.
SECURE_HSTS_SECONDS=0

# Tunnel token from Zero Trust → Networks → Tunnels → dragnet → Install.
CF_TUNNEL_TOKEN=
# Starts the cloudflared sidecar. Uncomment only once CF_TUNNEL_TOKEN is filled
# in — an empty token crash-loops the container.
#COMPOSE_PROFILES=tunnel

# --- Cloudflare Access SSO ---------------------------------------------------
# Both required for family logins. While either is empty, Access is ignored and
# only Django's own login page works. Team domain: Zero Trust → Settings →
# Custom Pages (e.g. jensenbox.cloudflareaccess.com). AUD: the Access
# application's "Application Audience (AUD) Tag".
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- put.io ------------------------------------------------------------------
# put.io OAuth token — create an app at https://app.put.io/oauth and use its OAuth token
PUTIO_OAUTH_TOKEN=
# Root-level folder for adult sends. Must stay OUTSIDE the rclone-watched
# folder so adult content never reaches the family Plex library.
PUTIO_ADULT_FOLDER=adult

# --- bitmagnet ---------------------------------------------------------------
# Password for bitmagnet's Postgres (internal to the compose network)
POSTGRES_PASSWORD=

# TMDB v3 API key (themoviedb.org → Settings → API) for bitmagnet's classifier
TMDB_API_KEY=

# Keep adult content in the index so the gated /adult/ section has something to
# search. Setting this back to true does NOT just hide adult content — it
# permanently blocklists every adult infohash the crawler sees from then on.
CLASSIFIER_DELETE_XXX=false

# bitmagnet's own dashboard (no auth, LAN only). Shown to staff on /status/.
# Leave empty to hide the link entirely.
BITMAGNET_DASHBOARD_URL=http://192.168.16.10:3333

# --- API ---------------------------------------------------------------------
# Bearer token for POST /api/download/ (programmatic sends, e.g. Claude Code).
# Leave empty to disable the API. Generate like SECRET_KEY.
DRAGNET_API_TOKEN=

# Optional: first deploy bootstraps this Django admin account
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
